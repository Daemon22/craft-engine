{
  "name": "@manya/craft-engine",
  "version": "0.2.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "description": "Craft engine: high-integrity archival tool (CLI + Library).",
  "author": "Uviwe Menyiwe (Azura Daemon)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "craft": "./bin/craft.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/lib/index.d.ts",
      "import": "./dist/esm/lib/index.js",
      "require": "./dist/cjs/lib/index.js",
      "default": "./dist/cjs/lib/index.js"
    },
    "./lib/craft": {
      "types": "./dist/types/lib/craft/index.d.ts",
      "import": "./dist/esm/lib/craft/index.js",
      "require": "./dist/cjs/lib/craft/index.js",
      "default": "./dist/cjs/lib/craft/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "build:codec": "npm --prefix craft-codec run build",
    "build:lib": "npm run build:codec && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && tsc -p tsconfig.types.json && node scripts/fix-esm-specifiers.cjs && node scripts/write-esm-package.cjs",
    "prepare": "npm run build:lib",
    "lint": "eslint src/lib",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "doctor": "node ./dist/cjs/lib/craft/cli/index.js doctor",
    "verify:package": "node scripts/verify-package.cjs"
  },
  "dependencies": {
    "@manya/craft-codec": "file:./craft-codec",
    "uuid": "^11.1.0",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "eslint": "^9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Daemon22/craft-engine.git",
    "directory": "."
  },
  "files": [
    "dist",
    "src",
    "craft-codec",
    "README.md",
    "LICENSE"
  ],
  "bundledDependencies": [
    "@manya/craft-codec"
  ]
}
