{
  "name": "@manya/craft-codec",
  "version": "0.1.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "description": "Original adaptive context-modeling range coder — a from-scratch compression codec (not a Brotli/Zstd wrapper), designed as an additional adaptive strategy for craft-engine.",
  "author": "Uviwe Menyiwe (Azura Daemon)",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  }
}
